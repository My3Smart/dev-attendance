{
  "name": "@lovable.dev/webhooks-js",
  "version": "0.0.3",
  "description": "Lovable Webhooks JS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovablelabs/lovable.git",
    "directory": "npm-packages/webhooks-js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "lovable",
    "webhook",
    "signature"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "tmp=$(mktemp -d) && pnpm pack --out \"$tmp/pkg.tgz\" && tar -xzf \"$tmp/pkg.tgz\" -C \"$tmp\" && publint \"$tmp/package\" --strict && attw \"$tmp/pkg.tgz\"",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  }
}